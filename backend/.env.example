# JusBid AI Sales Agency Backend Environment Variables (Placeholder Example)

# Application Environment (development | production | test)
NODE_ENV=development
PORT=5000

# Database Configuration (Optional during local startup)
# MONGODB_URI=mongodb://localhost:27017/jusbid_ai_sales

# Frontend Client URL (For CORS policies; Required in production)
# FRONTEND_URL=http://localhost:5173

# Authentication & Security (Optional until auth is enabled; minimum 32 characters in production)
# JWT_SECRET=your_secure_random_at_least_32_characters_secret_key

# OmniDimension Gateway Integration (Optional during local startup)
# OMNIDIMENSION_API_KEY=your_omnidimension_api_key_here
# OMNIDIMENSION_BASE_URL=https://api.omnidimension.ai/v1
# OMNIDIMENSION_AGENT_ID=your_omnidimension_agent_id_here
# OMNIDIMENSION_WEBHOOK_SECRET=your_omnidimension_webhook_signing_secret_here
